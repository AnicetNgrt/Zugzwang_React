{
  "name": "patherns",
  "author": "Anicet Nougaret",
  "version": "0.2.0",
  "description": "nothing yet",
  "private": true,
  "main": "./electron-start.js",
  "homepage": ".",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "pack": "npm run build && electron-builder build --dir",
    "dist": "npm run build && electron-builder build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "local-storage": "^2.0.0",
    "popmotion": "8.7.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6",
    "react-icons": "^5.2.1",
    "react-image-tint": "^1.0.2",
    "react-responsive-spritesheet": "^2.3.9",
    "react-textfit": "^1.1.1"
  },
  "devDependencies": {
    "@hello-pangea/dnd": "^16.6.0",
    "@types/howler": "^2.2.11",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-textfit": "^1.1.4",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "sass": "^1.77.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
